# Discord Bot Credentials
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# Optional — deploy slash commands to a single guild (faster for development)
DISCORD_GUILD_ID=

# Optional — Discord category ID for order tickets (auto-detected or created on startup if omitted)
TICKET_CATEGORY_ID=

# MongoDB — local example:
# MONGODB_URI=mongodb://localhost:27017/RizzBot
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<dbname>?retryWrites=true&w=majority
MONGODB_URI=
